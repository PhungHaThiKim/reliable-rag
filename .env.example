# Copy to .env (local) or add as Colab secrets. Never commit real values.
HF_TOKEN=            # only for gated models (meta-llama/*); NousResearch mirrors work without it
GITHUB_TOKEN=        # optional: fetch GitHub advisories with a higher rate limit
OPENAI_API_KEY=      # optional: --llm openai:<model>
OPENAI_BASE_URL=     # optional: e.g. http://localhost:8000/v1 for a vLLM server
